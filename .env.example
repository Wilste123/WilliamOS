OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Legacy fallback if SUPABASE_ANON_KEY is not set:
SUPABASE_KEY=your_supabase_anon_key_here
DOCUMENTS_BUCKET=documents
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Microsoft Outlook / Graph (optional — Integrasjoner → Outlook)
# Register app at https://portal.azure.com → App registrations
# Redirect URI: http://localhost:3000/integrations/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:3000/integrations/callback

# Optional: seed demo data (scripts/seed_demo_data.py) after first login
# SEED_USER_ID=
# SEED_HOUSEHOLD_ID=
# SEED_EMAIL=
# SEED_DISPLAY_NAME=William
