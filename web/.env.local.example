# Copy to .env.local
#
# Default: leave NEXT_PUBLIC_API_URL unset — browser uses /api (proxied to FastAPI).
# Only set this if FastAPI has its own public URL (separate ngrok tunnel).
# NEXT_PUBLIC_API_URL=https://your-api.ngrok-free.app

# Where Next.js server proxies /api requests (dev machine only)
API_PROXY_URL=http://127.0.0.1:8000
